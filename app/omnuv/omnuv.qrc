<!--
  Our own resource file, so upstream's qml.qrc stays untouched and out of the
  change budget. One more file here costs nothing; one more edit there costs a
  rebase.
-->
<RCC>
    <qresource prefix="/omnuv">
        <file>Aurora.qml</file>
        <file>DeployDialog.qml</file>
        <file>EstateRail.qml</file>
        <file>EstateHeader.qml</file>
        <file>Glyph.qml</file>
        <file>MachineArt.qml</file>
        <file>MachineCard.qml</file>
        <file>OmnuvButton.qml</file>
        <file>OmnuvSurface.qml</file>
        <file>OmnuvDialogTitle.qml</file>
        <file>OmnuvButtonBox.qml</file>
        <file>MessagesPanel.qml</file>
        <file>OmnuvCliSegue.qml</file>
        <file>OmnuvSegue.qml</file>
        <file>OmnuvView.qml</file>
        <file>OrganizationBand.qml</file>
        <file>Pill.qml</file>
        <file>StreamSettingsSheet.qml</file>
        <file>Theme.qml</file>
        <file>WorkloadMark.qml</file>
        <file>fonts/InstrumentSans-Variable.ttf</file>
        <file>fonts/JetBrainsMono-Regular.ttf</file>
        <file>fonts/JetBrainsMono-Medium.ttf</file>
        <file>fonts/OFL-InstrumentSans.txt</file>
        <file>fonts/OFL-JetBrainsMono.txt</file>
        <file>logos/nvidia.svg</file>
        <file>logos/tux.svg</file>
        <file>card-shadow.png</file>
        <file>estate.js</file>
        <file>framerates.js</file>
        <file>omnuv.svg</file>
    </qresource>
</RCC>
