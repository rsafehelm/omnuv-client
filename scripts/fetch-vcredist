#!/usr/bin/env bash
# The Visual C++ redistributables, into build/redist/, verified against the
# pins the bundle already carries.
#
#     scripts/fetch-vcredist          fetch if absent or wrong; print where
#
# **Why fetch them at all.** `Bundle.wxs` declares both redistributables with a
# `DownloadUrl` and no local payload, so `OmnuvSetup.exe` is a *downloading*
# installer: it needs Microsoft reachable at install time, and a machine behind
# a proxy, on a locked-down network, or simply offline gets a bundle that
# cannot finish. Embedding them makes the one file actually contain everything
# it needs.
#
# **The pins are read out of `Bundle.wxs`, never repeated here.** They are
# generated by `scripts/update-msvcredist.ps1`, so a copy in this file would be
# a second definition of one fact that drifts the first time somebody runs that
# generator — the shape CLAUDE.md records under *a change that lives in only
# one place*. This parses the `<?define ?>` lines instead, which means updating
# the redistributable stays a one-command job.
#
# SHA512 rather than SHA256 because that is what WiX pins and what Microsoft
# publishes for these.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bundle="$here/wix/OmnuvSetup/Bundle.wxs"
out="$here/build/redist"

[ -f "$bundle" ] || { echo "FAIL: $bundle is missing" >&2; exit 1; }

# One `<?define NAME = "value" ?>` per line, which is what the generator emits.
pin() {
    sed -n "s/.*<?define $1 = \"\([^\"]*\)\".*/\1/p" "$bundle" | head -1
}

mkdir -p "$out"
fetched=cached

for arch in X64 ARM64; do
    lower="$(echo "$arch" | tr '[:upper:]' '[:lower:]')"
    url="$(pin "VCREDIST_${arch}_URL")"
    want="$(pin "VCREDIST_${arch}_SHA512")"
    size="$(pin "VCREDIST_${arch}_SIZE")"
    file="$out/VC_redist.${lower}.exe"

    if [ -z "$url" ] || [ -z "$want" ]; then
        echo "FAIL: no pin for VCREDIST_${arch} in $bundle" >&2
        exit 1
    fi

    # Uppercased on both sides: WiX writes the digest in capitals and
    # sha512sum prints lowercase, and a comparison that is only ever wrong
    # would re-download for ever while reporting nothing amiss.
    have=""
    [ -f "$file" ] && have="$(sha512sum "$file" | cut -d' ' -f1 | tr '[:lower:]' '[:upper:]')"
    if [ "$have" = "$(echo "$want" | tr '[:lower:]' '[:upper:]')" ]; then
        echo "VCREDIST_${arch}=$file"
        continue
    fi

    curl -fsSL "$url" -o "$file.part"
    got="$(sha512sum "$file.part" | cut -d' ' -f1 | tr '[:lower:]' '[:upper:]')"
    if [ "$got" != "$(echo "$want" | tr '[:lower:]' '[:upper:]')" ]; then
        echo "FAIL: VC_redist.${lower}.exe does not match the pin in Bundle.wxs" >&2
        echo "  expected $want" >&2
        echo "  got      $got" >&2
        rm -f "$file.part"
        exit 1
    fi
    # The declared size is a second, independent statement about the same file;
    # checking it costs nothing and catches a pin somebody updated by halves.
    actual="$(stat -c%s "$file.part")"
    if [ -n "$size" ] && [ "$actual" != "$size" ]; then
        echo "FAIL: VC_redist.${lower}.exe is $actual bytes; Bundle.wxs says $size" >&2
        rm -f "$file.part"
        exit 1
    fi
    mv "$file.part" "$file"
    fetched=yes
    echo "VCREDIST_${arch}=$file"
done

echo "REDISTDIR=$out"
echo "VCREDISTFETCHED=$fetched"
