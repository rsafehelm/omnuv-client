package main

// Machine mode against a real NetBird: the management and signal servers of
// v0.78.1, in this process, built the way NetBird's own client/embed test
// builds them, and the tunnel's real start path (netbird.New, NoUserspace: a
// WireGuard interface in this container). Laid into the tunnel's package by
// run.sh, so it is never part of `go test ./...`.
//
// Every assertion prints a PROOF line when it holds.

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"log"
	"net"
	"os"
