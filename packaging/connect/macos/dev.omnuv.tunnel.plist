<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The private-network daemon, as root: making the utun adapter needs it, and
     the client, running as the person, talks to it over /var/run/onv-tunnel.sock.
     The counterpart of linux/onv-tunnel.service. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.omnuv.tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/Omnuv/onvtunneld</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/onv-tunnel.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/onv-tunnel.log</string>
</dict>
</plist>
