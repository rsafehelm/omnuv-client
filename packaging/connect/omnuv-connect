#!/bin/sh
# Omnuv Connect — joins this device to your private network.
#
# One command, on Linux and macOS. It does three things and nothing else:
# installs the tunnel client if it is missing, joins the network with the key
# from your Omnuv console, and tells you whether it worked.
#
#   omnuv-connect enrol                  join the private network (asks for the key)
#   omnuv-connect enrol --gaming         and install the game streaming client
#   omnuv-connect enrol --yes            join without asking, once it has said where
#   omnuv-connect status                 is it connected?
#   omnuv-connect leave                  disconnect this device
#   omnuv-connect sign-in <core-url>     approve this device in a browser
#   omnuv-connect handle omnuv://…       what the console's buttons open
#
# We install the tunnel and streaming clients from their own publishers rather
# than shipping copies inside this package. That way you get the current
# version, security updates come from the people who write them, and we are not
# redistributing somebody else's software.
set -eu

# Replaced at build time. Override with --management-url for another deployment.
MANAGEMENT_URL="@MANAGEMENT_URL@"
CORE_URL="@CORE_URL@"
VERSION="@VERSION@"

say()  { printf '%s\n' "$*"; }
die()  { printf 'omnuv-connect: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# sudo only where it is actually needed, and never silently.
as_root() {
    if [ "$(id -u)" = 0 ]; then "$@"; else
        have sudo || die "this step needs administrator rights and sudo is not installed"
        sudo "$@"
    fi
}

os() {
    case "$(uname -s)" in
        Linux)  echo linux ;;
        Darwin) echo macos ;;
        *) die "this installer supports Linux and macOS. On Windows use the Omnuv Connect installer." ;;
    esac
}

# **The tunnel client, pinned (H11).** This used to run the publisher's
# install.sh as root, fetched unpinned, so whatever that URL served on the day
# ran with full rights. Now it is one release, the one the Windows tunnel is
# built from (tunnel/go.mod), checked against a digest written here before a
# byte of it is unpacked. The digests are the release's own checksums file,
# confirmed against the tarballs on 23 September 2026. A newer netbird means a
# change here, reviewed, not a different download.
NETBIRD_VERSION=0.78.1
netbird_digest() {
    case "$1" in
        linux_amd64)  echo 9239c9e37c2acc0612563ef5ce0c3326397460d0eb811b5a59a8e373f1a4ebde ;;
        linux_arm64)  echo d686745aa64bb4c597602ce95e76558f5f848d0672c88d63f96397d2507005b2 ;;
        darwin_amd64) echo 1441be19db0394497866fc19a519d7d0483fbad0fcd4d1adaeb0ed1bded739be ;;
        darwin_arm64) echo 8d613dc78aa0e5b9f01b07ec9d02417c27638bf68b829a72399293f76da0fa03 ;;
    esac
}

sha256_of() {
    if have sha256sum; then sha256sum "$1" | cut -d' ' -f1
    else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

install_tunnel() {
    have netbird && return 0
    case "$(uname -s)" in Linux) sys=linux ;; Darwin) sys=darwin ;; *) die "this installer supports Linux and macOS" ;; esac
    case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) die "no tunnel client is published for $(uname -m)" ;; esac
    want=$(netbird_digest "${sys}_$arch")
    have curl || die "curl is required"
    say "Installing the tunnel client $NETBIRD_VERSION from its publisher…"
    tmp=$(mktemp -d) || die "could not make a working directory"
    tarball="$tmp/netbird.tar.gz"
    curl -fsSL -o "$tarball" \
        "https://github.com/netbirdio/netbird/releases/download/v$NETBIRD_VERSION/netbird_${NETBIRD_VERSION}_${sys}_$arch.tar.gz" \
        || { rm -rf "$tmp"; die "the tunnel client could not be downloaded"; }
    got=$(sha256_of "$tarball")
    if [ "$got" != "$want" ]; then
        rm -rf "$tmp"
        die "the tunnel client download did not match its published digest, so nothing was installed (expected $want, got $got)"
    fi
    tar -xzf "$tarball" -C "$tmp" netbird || { rm -rf "$tmp"; die "the tunnel client archive would not unpack"; }
    # The binary and its background service, which is what lets a name like
    # gpu-1.internal resolve on this device.
    as_root install -d -m 0755 /usr/local/bin \
        && as_root install -m 0755 "$tmp/netbird" /usr/local/bin/netbird \
        || { rm -rf "$tmp"; die "the tunnel client would not install"; }
    rm -rf "$tmp"
    as_root /usr/local/bin/netbird service install || die "the tunnel service would not install"
    as_root /usr/local/bin/netbird service start || die "the tunnel service would not start"
    have netbird || die "the tunnel client installed but is not on PATH; open a new terminal and try again"
}

install_gaming() {
    have moonlight || have moonlight-qt || [ -d /Applications/Moonlight.app ] || {
        say "Installing the game streaming client…"
        case "$(os)" in
            macos)
                have brew || die "install Homebrew, or download Moonlight from moonlight-stream.org"
                brew install --cask moonlight
                ;;
            linux)
                if have flatpak; then
                    flatpak install -y --noninteractive flathub com.moonlight_stream.Moonlight
                else
                    say "Flatpak is not installed. Get Moonlight from https://moonlight-stream.org"
                fi
                ;;
        esac
    }
}

# ---- omnuv:// links ----
#
# The console emits these so a person clicks a button instead of remembering a
# machine's name. Any web page can emit them too, so a link carries nothing a
# page could choose to harm with: never a network key (H3, 22 September 2026).
#
#   omnuv://join
#   omnuv://stream?host=<name>.internal&app=<application>
#   omnuv://ssh?host=<name>.internal&user=<user>

urldecode() {
    # %20 and friends, and + for a space, without depending on python. Octal,
    # not `printf '%b'` with `\x`: dash, which is /bin/sh on Ubuntu, has no
    # `\x`, so `%26` came out as the text `\x26`. A `%` not followed by two hex
    # digits stays as it is.
    s="$(printf '%s' "$1" | sed 's/+/ /g')"; out=''
    while :; do
        case "$s" in *%*) ;; *) break ;; esac
        out="$out${s%%\%*}"; s="${s#*%}"
        case "$s" in
            [0-9A-Fa-f][0-9A-Fa-f]*)
                h="${s%"${s#??}"}"; s="${s#??}"
                # The x keeps a decoded newline from being eaten by $( ).
                c="$(printf "\\$(printf '%03o' "0x$h")x")"; out="$out${c%x}" ;;
            *) out="$out%" ;;
        esac
    done
    printf '%s' "$out$s"
}

# One parameter out of a query string, decoded. Missing is empty, which every
# caller checks.
# The trailing newline matters: `read` fails on a last line without one, so the
# last parameter was dropped, and a one-parameter link named no machine at all.
param() {
    printf '%s\n' "$2" | tr '&' '\n' | while IFS= read -r pair; do
        case "$pair" in
            "$1"=*) urldecode "${pair#*=}"; return ;;
        esac
    done
}

# **The client this package ships, where it ships one (24 September 2026).**
# The Linux .deb carries the Omnuv client, its Qt and the tunnel service, as
# the Windows installer does; the operator's decision was one package. Where
# it is installed it does everything below: enrolling, streaming, the link a
# console button opens. NetBird and upstream Moonlight are never fetched then.
# The macOS package does not carry it yet (it needs the Mac rig to build), so
# there the older path stays.
# OMNUV_CONNECT_CLIENT is for tests; it is the same trust as PATH.
BUNDLED="${OMNUV_CONNECT_CLIENT:-/opt/omnuv/bin/OmnuvClient}"
bundled() { [ -x "$BUNDLED" ]; }

launch_stream() {
    host="$1"; app="$2"
    if bundled; then
        [ -n "$app" ] && exec "$BUNDLED" stream "$host" "$app"
        exec "$BUNDLED" stream "$host"
    fi
    for m in moonlight moonlight-qt; do
        if have "$m"; then
            # Verified against the client's own parser: stream <host> "<app>".
            [ -n "$app" ] && exec "$m" stream "$host" "$app"
            exec "$m" stream "$host"
        fi
    done
    if have flatpak && flatpak info com.moonlight_stream.Moonlight >/dev/null 2>&1; then
        [ -n "$app" ] && exec flatpak run com.moonlight_stream.Moonlight stream "$host" "$app"
        exec flatpak run com.moonlight_stream.Moonlight stream "$host"
    fi
    [ -d /Applications/Moonlight.app ] && exec open -a Moonlight --args stream "$host" "$app"
    die "the game streaming client is not installed: run omnuv-connect enrol --gaming"
}

# **A link is input from any web page, not from the console.** Anything can
# emit omnuv://, so every value is checked against what the console actually
# sends before it reaches a program: a host starting with `-` is an ssh option
# (`-oProxyCommand=…`), and gnome-terminal's `-e` re-parses its argument.
# `case` rather than grep: grep matches per line, so a value with a newline in
# it passes if any one line does.
valid_host() {
    case "$1" in
        ''|*[!A-Za-z0-9.-]*|[.-]*|*[.-]|*..*|*.-*|*-.*) return 1 ;;
    esac
    [ "${#1}" -le 253 ]
}
valid_user() {
    case "$1" in
        '') return 0 ;;
        *[!A-Za-z0-9_.-]*|[!A-Za-z_]*) return 1 ;;
    esac
    [ "${#1}" -le 32 ]
}
valid_app() {
    case "$1" in
        -*|*'"'*|*[[:cntrl:]]*) return 1 ;;
    esac
    [ "${#1}" -le 128 ]
}

launch_ssh() {
    host="$1"; user="${2:-}"
    target="$host"
    [ -n "$user" ] && target="$user@$host"
    # A terminal, because a link click has no terminal of its own.
    for t in x-terminal-emulator gnome-terminal konsole xterm; do
        have "$t" && exec "$t" -e ssh "$target"
    done
    [ "$(os)" = macos ] && exec open -a Terminal "ssh://$target"
    die "no terminal found. Run: ssh $target"
}

handle() {
    url="${1:-}"
    case "$url" in
        omnuv://*) ;;
        *) die "not an omnuv link: $url" ;;
    esac
    rest="${url#omnuv://}"
    action="${rest%%\?*}"
    action="${action%%/*}"
    query=""
    case "$rest" in *\?*) query="${rest#*\?}" ;; esac

    case "$action" in
        enrol|enroll|join)
            # A link never carries a key: any page can open omnuv://, and a
            # key it chose would join this device to its network (H3). A link
            # without one asks the app to join with its own sign-in; there is
            # no app in this package yet, so say what to do instead.
            [ -z "$(param key "$query")" ] || die "a link can no longer carry a network key. In the console, use \"Get command\" and run the command it shows."
            # The app joins with its own sign-in; opening it is the join.
            bundled && exec "$BUNDLED"
            die "this device has no Omnuv app to join with its sign-in. In the console, use \"Get command\" and run the command it shows."
            ;;
        stream)
            host="$(param host "$query")"
            [ -n "$host" ] || die "that link names no machine"
            valid_host "$host" || die "that link names a machine this will not open: $host"
            app="$(param app "$query")"
            valid_app "$app" || die "that link names an application this will not open: $app"
            launch_stream "$host" "$app"
            ;;
        ssh)
            host="$(param host "$query")"
            [ -n "$host" ] || die "that link names no machine"
            valid_host "$host" || die "that link names a machine this will not open: $host"
            user="$(param user "$query")"
            valid_user "$user" || die "that link names a user this will not open: $user"
            launch_ssh "$host" "$user"
            ;;
        *) die "unknown link: omnuv://$action" ;;
    esac
}

# Asks Core which device, network, project and organization a key joins, says
# so, and asks for a yes. The key goes in the request body on stdin, never on
# curl's command line. "Could not ask" stops here too: it is not a yes.
key_leads_where() {
    # **A pattern, never the placeholder itself.** build.sh substitutes every
    # occurrence of the placeholder, so a guard spelled with it compared the
    # built address with itself and refused every enrolment that did not pass
    # the address again by hand (found on the Linux rig, 24 September 2026).
    case "$CORE_URL" in ''|@*@) die "no Omnuv address was built into this package; pass --core-url" ;; esac
    case "$(origin_of "$CORE_URL")" in
        https://*|http://127.*|'http://[::1]'*) ;;
        *) die "$CORE_URL is not an https:// address, and a key is never sent over plain http" ;;
    esac
    # A key is letters, digits and dashes; anything else is not one, and
    # would not survive being written into JSON by printf.
    case "$1" in *[!A-Za-z0-9-]*) die "that does not look like a key from the Omnuv console" ;; esac
    have curl || die "curl is required"
    reply=$(printf '{"key":"%s"}' "$1" | curl -sS -w '\n%{http_code}' -H 'content-type: application/json' \
        --data-binary @- "${CORE_URL%/}/v1/devices/key-info" 2>/dev/null) || reply="
000"
    status=$(printf '%s' "$reply" | tail -n 1)
    body=$(printf '%s' "$reply" | sed '$d')
    field() { printf '%s' "$body" | sed -n "s/.*\"$1\" *: *\"\([^\"]*\)\".*/\1/p"; }
    case "$status" in
        200) ;;
        404) die "$CORE_URL did not issue that key. Check you copied it from your own console." ;;
        *) die "could not ask $CORE_URL where that key leads (HTTP $status), so it was not used. Try again." ;;
    esac
    printf '%s' "$body" | grep -q '"usable" *: *true' \
        || die "that key has already been used, was cancelled, or has expired. Add the device again in the console."
    say ""
    say "  This key joins this computer, as \"$(field device)\","
    say "  to the network \"$(field network)\" of project \"$(field project)\""
    say "  in the organization \"$(field organization)\", at $CORE_URL."
    say ""
    [ "$yes" = 1 ] && return 0
    # The key may have come down a pipe, so the answer is read from the
    # terminal. With no terminal, only --yes goes on.
    ( : < /dev/tty ) 2>/dev/null || die "no terminal to confirm on; run again with --yes if that is right"
    printf '  Join it? [y/N] ' >&2
    IFS= read -r answer < /dev/tty || answer=""
    case "$answer" in y|Y|yes|YES|Yes) ;; *) die "not joined; the key was not used" ;; esac
}

enrol() {
    key=""
    gaming=0
    yes=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --gaming) gaming=1; shift ;;
            --management-url) MANAGEMENT_URL="${2:-}"; shift 2 ;;
            --core-url) CORE_URL="${2:-}"; shift 2 ;;
            --yes) yes=1; shift ;;
            -*) die "unknown option $1" ;;
            *) key="$1"; shift ;;
        esac
    done
    # **Asked for, or read from a pipe, rather than typed as an argument
    # (H3b, 22 September 2026)**: any process can read another's command line,
    # and a shell keeps it in its history. An argument still works.
    if [ -z "$key" ]; then
        if [ -t 0 ]; then
            printf 'Paste the key from your Omnuv console: ' >&2
            stty -echo 2>/dev/null; IFS= read -r key || true; stty echo 2>/dev/null; printf '\n' >&2
        else
            IFS= read -r key || true
        fi
        key=$(printf '%s' "$key" | tr -d '[:space:]')
    fi
    [ -n "$key" ] || die "usage: omnuv-connect enrol   (and paste the key from your Omnuv console when asked)"
    case "$MANAGEMENT_URL" in ''|@*@) die "no network address was built into this package; pass --management-url" ;; esac

    # **Where the key leads, before it is spent (H3).** A pasted key could be
    # anybody's, and the management address alone does not say whose network
    # it joins. Core answers for a key it minted; a key it did not mint, or one
    # already spent, is refused here rather than handed to the tunnel.
    key_leads_where "$key"

    if bundled; then
        say "Joining your private network…"
        # **Forwarded, not reimplemented**, as omnuv-connect.ps1 does: the
        # client asks the tunnel service, which holds the network. The key goes
        # on its standard input, never its command line.
        printf '%s\n' "$key" | "$BUNDLED" enrol --key-stdin --management-url "$MANAGEMENT_URL" \
            || die "the device did not join. Check the key has not already been used."
        say ""
        say "Connected. Your machines are reachable by name, for example:"
        say "    ssh gpu-1.internal"
        say "    or open Omnuv, which lists them by name"
        say ""
        say "This device now appears in your Omnuv console under Network, where you can revoke it."
        return 0
    fi

    install_tunnel
    [ "$gaming" = 1 ] && install_gaming

    say "Joining your private network…"
    # The key spends itself: it enrols this one device and cannot be reused.
    # Handed over in a file only this user and root can read, removed after,
    # never as --setup-key on netbird's command line.
    keyfile=$(umask 077; mktemp) || die "could not make a private file for the key"
    printf '%s\n' "$key" > "$keyfile"
    joined=0
    as_root netbird up --management-url "$MANAGEMENT_URL" --setup-key-file "$keyfile" && joined=1
    rm -f "$keyfile"
    [ "$joined" = 1 ] || die "the device did not join. Check the key has not already been used."

    say ""
    say "Connected. Your machines are reachable by name, for example:"
    say "    ssh gpu-1.internal"
    [ "$gaming" = 1 ] && say "    Open Moonlight and point it at <machine>.internal"
    say ""
    say "This device now appears in your Omnuv console under Network, where you can revoke it."
}

# ---- signing in ----
#
# P8's first step, usable before the application exists: the command shows a
# short code, the person approves it in a browser where they are already signed
# in, and this collects a token. No password is ever typed into software the
# person downloaded.
# The Core a token is kept for, spelled as the app spells it
# (OmnuvCredentials::origin): scheme and host lower-cased, no user info, path,
# query or fragment, and no default port. Empty for anything not http(s).
origin_of() {
    scheme=$(printf '%s' "$1" | sed -n 's#^\([A-Za-z][A-Za-z0-9+.-]*\)://.*#\1#p' | tr 'A-Z' 'a-z')
    case "$scheme" in http|https) ;; *) return 0 ;; esac
    hostport="${1#*://}"; hostport="${hostport%%/*}"; hostport="${hostport%%\?*}"; hostport="${hostport%%#*}"
    hostport="${hostport##*@}"; hostport=$(printf '%s' "$hostport" | tr 'A-Z' 'a-z')
    case "$scheme:$hostport" in https:*:443) hostport="${hostport%:443}" ;; http:*:80) hostport="${hostport%:80}" ;; esac
    [ -n "${hostport%%:*}" ] || return 0
    printf '%s://%s' "$scheme" "$hostport"
}

# Where the app reads that Core's token (credentials.cpp, filePath): the first
# 16 hex of sha256(origin), under tokens/.
token_slot() {
    if have sha256sum; then digest=$(printf '%s' "$1" | sha256sum)
    else digest=$(printf '%s' "$1" | shasum -a 256); fi
    printf '%s/.config/omnuv/tokens/%s' "$HOME" "$(printf '%s' "$digest" | cut -c1-16)"
}

sign_in() {
    core="${1:-$CORE_URL}"
    [ -n "$core" ] || die "usage: omnuv-connect sign-in <https://core-address>"
    origin=$(origin_of "$core")
    [ -n "$origin" ] || die "$core is not an http(s) address"
    # A token that never expires is not sent in the clear, except to this
    # machine (H2; the app's OmnuvCredentials::secureCore).
    case "$origin" in
        https://*|http://127.*|'http://[::1]'*) ;;
        *) die "$core is not an https:// address, and a sign-in is never sent over plain http" ;;
    esac
    have curl || die "curl is required"
    start=$(curl -fsS -H 'content-type: application/json' \
        -d "{\"client\":\"Omnuv Connect $VERSION on $(uname -s)\"}" \
        "$core/v1/auth/device") || die "could not reach $core"
    # Optional spaces around the colon: Core sends compact JSON, but a proxy or
    # a later serializer need not.
    code=$(printf '%s' "$start" | sed -n 's/.*"user_code" *: *"\([^"]*\)".*/\1/p')
    device=$(printf '%s' "$start" | sed -n 's/.*"device_code" *: *"\([^"]*\)".*/\1/p')
    uri=$(printf '%s' "$start" | sed -n 's/.*"verification_uri" *: *"\([^"]*\)".*/\1/p')
    interval=$(printf '%s' "$start" | sed -n 's/.*"interval" *: *\([0-9][0-9]*\).*/\1/p')
    expires=$(printf '%s' "$start" | sed -n 's/.*"expires_in" *: *\([0-9][0-9]*\).*/\1/p')
    deadline=$(( $(date +%s) + ${expires:-600} ))
    [ -n "$device" ] || die "$core did not start a sign-in: $start"
    say ""
    say "  Open $uri and enter this code:"
    say ""
    say "      $code"
    say ""
    say "  Waiting…"
    # Polled at the interval the server asked for, not one this guessed.
    #
    # **One request per poll, and its body is kept.** The status used to be
    # read with the body sent to /dev/null, and a second request made for the
    # token once the status said 200. But the token is issued once: the 200
    # was the token, and it was thrown away, so the second collect was refused
    # and every sign-in failed while leaving a live token nobody held.
    while :; do
        sleep "${interval:-5}"
        # **A failure in passing is not an answer (H20).** No answer, or a
        # 5xx, ended the sign-in — perhaps after it had been approved. It is
        # asked again until the code expires; only Core saying no ends it, in
        # Core's own words (H23).
        reply=$(curl -sS -w '\n%{http_code}' -H 'content-type: application/json' \
            -d "{\"device_code\":\"$device\"}" "$core/v1/auth/device/token" 2>/dev/null) \
            || reply="
000"
        status=$(printf '%s' "$reply" | tail -n 1)
        case "$status" in
            202) continue ;;
            200) break ;;
            000|5??)
                [ "$(date +%s)" -lt "$deadline" ] || die "the code expired while $core was not answering; start again"
                say "  $core is not answering; still waiting…"
                continue ;;
            *)
                said=$(printf '%s' "$reply" | sed '$d' | sed -n 's/.*"error" *: *"\([^"]*\)".*/\1/p')
                die "that sign-in did not complete: ${said:-refused or expired}" ;;
        esac
    done
    token=$(printf '%s' "$reply" | sed '$d' | sed -n 's/.*"token" *: *"\([^"]*\)".*/\1/p')
    [ -n "$token" ] || die "$core approved the sign-in but sent no token"
    # **This Core's own slot, never the old single one (H16, 22 September
    # 2026).** The single file carried no Core, so an app whose saved address
    # was another moved this token into that Core's slot and sent it there.
    umask 077
    slot=$(token_slot "$origin")
    mkdir -p "${slot%/*}"
    printf '%s\n' "$token" > "$slot"
    say "Signed in. Take this access back any time in the console, under Network."
}

case "${1:-}" in
    handle) shift; handle "$@" ;;
    sign-in|signin|login) shift; sign_in "$@" ;;
    enrol|enroll|join) shift; enrol "$@" ;;
    status)
        if bundled; then
            if systemctl is-active --quiet onv-tunnel.service 2>/dev/null; then
                say "The Omnuv network service is running. Open Omnuv to see this device's network."
            else
                die "the Omnuv network service is not running: sudo systemctl start onv-tunnel"
            fi
        else
            have netbird || die "not installed yet: run omnuv-connect enrol"; netbird status
        fi ;;
    leave|disconnect)
        if bundled; then
            as_root systemctl stop onv-tunnel.service && say "Disconnected until the service starts again. Revoke the device in the console to remove it for good."
        else
            as_root netbird down && say "Disconnected. Revoke the device in the console to remove it for good."
        fi ;;
    version|--version) say "omnuv-connect $VERSION" ;;
    *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
