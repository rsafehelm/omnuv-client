<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>$(INSTALLER_FOLDER)\</OutputPath>
    <IntermediateOutputPath>$(BUILD_FOLDER)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>
  <!--
    Where the Visual C++ redistributable is found. It is carried inside the
    bundle rather than downloaded at install time, so this has to exist before
    a bundle can be built: `scripts/fetch-vcredist` puts it there, verified
    against the pins at the top of Bundle.wxs. REDIST_FOLDER overrides it for a
    build that keeps its artefacts elsewhere.
  -->
  <PropertyGroup>
    <RedistFolder Condition=" '$(REDIST_FOLDER)' != '' ">$(REDIST_FOLDER)</RedistFolder>
    <RedistFolder Condition=" '$(RedistFolder)' == '' ">$(MSBuildThisFileDirectory)..\..\build\redist</RedistFolder>
  </PropertyGroup>
  <!--
    **onv-replace-old.exe** (ReplaceOld.cs): removes a bundle registered under
    the upgrade code used until 0.2.2, chained after the MSI. Built here by the
    .NET Framework's own compiler, which every Windows 10 and later carries,
    so the bundle build needs nothing installed for it.
  -->
  <PropertyGroup>
    <ReplaceOldExe>$(IntermediateOutputPath)onv-replace-old.exe</ReplaceOldExe>
    <DefineConstants>RedistDir=$(RedistFolder);ReplaceOldExe=$(ReplaceOldExe)</DefineConstants>
  </PropertyGroup>
  <Target Name="BuildReplaceOld" BeforeTargets="BeforeBuild;CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:exe /platform:anycpu /optimize+ /out:&quot;$(ReplaceOldExe)&quot; &quot;$(MSBuildThisFileDirectory)ReplaceOld.cs&quot;" />
  </Target>
  <PropertyGroup Condition="$(SIGN)!=''">
    <SignOutput>true</SignOutput>
  </PropertyGroup>
  <Target Name="SignBundleEngine">
    <Exec Command='signtool.exe $(SIGNTOOL_PARAMS) %(SignBundleEngine.FullPath)' />
  </Target>
  <Target Name="SignBundle">
    <Exec Command='signtool.exe $(SIGNTOOL_PARAMS) %(SignBundle.FullPath)' />
  </Target>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>