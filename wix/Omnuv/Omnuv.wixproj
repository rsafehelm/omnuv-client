<Project Sdk="WixToolset.Sdk/7.0.0" ToolsVersion="5.0">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>$(BUILD_FOLDER)\</OutputPath>
    <IntermediateOutputPath>$(BUILD_FOLDER)\</IntermediateOutputPath>
  </PropertyGroup>
  <!--
    Where onvtunneld.exe and wintun.dll are found. Deliberately outside
    DEPLOY_FOLDER: Product.wxs harvests that whole tree with <Files Include>,
    and a file WiX generates a component for is a file nothing can attach a
    ServiceInstall or a FirewallException to.

    Defaults beside the source so an ordinary build-arch.bat works with nothing
    set, and TUNNEL_FOLDER overrides it for a build that keeps its artefacts
    elsewhere. A missing file fails the build, which is right: a client shipped
    without its tunnel has no private network, and that is not a thing to
    discover on a buyer's machine.

    **Per architecture, and `$(Platform)` is what selects it.** `tunnel/build.sh`
    writes `dist/x64` and `dist/arm64` under exactly those names, and
    `scripts/fetch-wintun` does the same for Wintun, so there is one path with the
    architecture substituted rather than two vocabularies to translate between.
    Without this an arm64 MSI packaged the x64 daemon: it failed no build, and
    the only machine that would have noticed is one nobody had built for.
  -->
  <PropertyGroup>
    <TunnelFolder Condition=" '$(TUNNEL_FOLDER)' != '' ">$(TUNNEL_FOLDER)</TunnelFolder>
    <TunnelFolder Condition=" '$(TunnelFolder)' == '' ">$(MSBuildThisFileDirectory)..\..\tunnel\dist\$(Platform)</TunnelFolder>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The omnuv:// handler, from the tree, as the NSIS installer takes it (F2). -->
    <ConnectFolder>$(MSBuildThisFileDirectory)..\..\packaging\connect</ConnectFolder>
    <DefineConstants>DeployDir=$(DEPLOY_FOLDER);BuildDir=$(BUILD_FOLDER);TunnelDir=$(TunnelFolder);ConnectDir=$(ConnectFolder)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>
  <PropertyGroup Condition="$(SIGN)!=''">
    <SignOutput>true</SignOutput>
  </PropertyGroup>
  <Target Name="SignMsi">
    <Exec Command='signtool.exe $(SIGNTOOL_PARAMS) %(SignMsi.FullPath)' />
  </Target>
  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>