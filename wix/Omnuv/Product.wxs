<?define ShortName = "Omnuv" ?>
<?define FullName = "Omnuv Client" ?>

<?define ShortcutName = "$(var.ShortName)" ?>
<?define ShortcutDesc = "Stream games and other applications from another PC" ?>
<?define InstallFolder = "Omnuv" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="$(var.FullName)"
           Language="1033"
           Version="!(bind.fileVersion.OmnuvClientExe)"
           Manufacturer="Omnuv"
           UpgradeCode="3c64f1f8-c43d-468a-ae92-7a6da2622ce2">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate CompressionLevel="high" EmbedCab="yes" />

    <Property Id="APPDATAFOLDER" Value="%LOCALAPPDATA%\Omnuv" />

    <!--
      **A default, so the MSI can be installed on its own.** Nothing declared
      this property: the bundle sets it and the UI sets it, so every install
      anyone had ever run supplied a value. A bare `msiexec /i … /qn` does not,
      and `OmnuvDesktopShortcutState` below writes it as an *integer* — an
      empty integer, which fails with `Error 1406. Could not write value
      DesktopShortcutInstallState … System error .` and rolls the whole
      installation back at InstallFinalize.

      The blank system error is what makes it read as a permissions problem; it
      is not. Measured 17 September installing the MSI silently on a clean
      Windows rig, which is the first time it had been done.

      0 rather than 1: a silent install should not put something on a desktop
      nobody asked about. The bundle and the UI both override it.
    -->
    <Property Id="ADDDESKTOPSHORTCUT" Value="0" />

    <!-- There's no way to delete a registry key on uninstall but not major upgrade, so
        we have to roll our own deletion via custom action -->
    <CustomAction Id="DeleteRegistryKey"
                  Directory="ProgramFiles6432Folder"
                  ExeCommand="reg.exe delete &quot;HKCU\Software\Omnuv&quot; /f"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="DeleteRegistryKey"
              Before="InstallFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Component Id="OmnuvShortcuts" Directory="INSTALLFOLDER">
      <Shortcut Id="StartMenuShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#OmnuvClientExe]"
                Directory="ApplicationProgramsFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupStartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    On="uninstall" />
      <util:RemoveFolderEx Id="CleanupAppDataFolder"
                           On="uninstall"
                           Property="APPDATAFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\Omnuv"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="OmnuvDesktopShortcut" Directory="INSTALLFOLDER" Condition="ADDDESKTOPSHORTCUT=1">
      <Shortcut Id="DesktopShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#OmnuvClientExe]"
                Directory="DesktopFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupDesktopShortcut"
                    Directory="DesktopFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Omnuv"
                     Name="DesktopShortcutInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Persist desktop shortcut's installed state to let Bundle.wxs know if
         the desktop shortcut should installed by default when upgrading the
         product -->
    <Component Id="OmnuvDesktopShortcutState" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU"
                     Key="Software\Omnuv"
                     Name="DesktopShortcutInstallState"
                     Type="integer"
                     Value="[ADDDESKTOPSHORTCUT]"
                     KeyPath="yes" />
    </Component>

    <!--
      **The omnuv:// scheme (F2, 23 September 2026)**, so the console's
      Connect, Stream and SSH buttons open this install as they open one from
      the Omnuv Connect installer. Held back until H3 was fixed, because a link
      used to carry a network key any web page could choose; no link carries
      one now, and the script refuses one that does.

      The same handler as omnuv-connect.nsi, and for the same reason
      PowerShell directly rather than a .cmd (H3c): cmd expands %VAR% inside a
      URL and lets a raw quote end the argument, and -File hands the script
      the URL as it arrived. The script finds OmnuvClient.exe beside itself.
      Unfilled placeholders are harmless here: `handle` reads none of them.
    -->
    <Component Id="OmnuvLinks" Directory="INSTALLFOLDER">
      <File Id="OmnuvConnectPs1"
            KeyPath="yes"
            Source="$(var.ConnectDir)\omnuv-connect.ps1" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\omnuv">
        <RegistryValue Type="string" Value="URL:Omnuv" />
        <RegistryValue Type="string" Name="URL Protocol" Value="" />
        <RegistryValue Type="string" Key="DefaultIcon" Value="[#OmnuvClientExe],0" />
        <RegistryValue Type="string" Key="shell\open\command"
                       Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#OmnuvConnectPs1]&quot; handle &quot;%1&quot;" />
      </RegistryKey>
    </Component>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="OmnuvClient">
        <File Id="OmnuvClientExe"
              KeyPath="yes"
              Checksum="yes"
              Source="$(var.BuildDir)\app\$(var.Configuration)\OmnuvClient.exe">
          <fire:FirewallException Id="OmnuvClientFirewallException"
                                  Scope="any"
                                  IgnoreFailure="yes"
                                  Name="$(var.FullName)" />
        </File>
      </Component>

      <!--
        The private network's privileged half.

        **A service, because creating a WireGuard adapter needs administrator
        rights** and the client does not have them in a login session —
        measured on the rig, where identical code joins in twenty seconds from
        an elevated session and dies after ninety in an ordinary one. So the
        installer is the only thing in a position to register it: it is the one
        part of the product that runs elevated on a buyer's machine.

        **Its own firewall exception, because ICE is done by this process.**
        The exception above names OmnuvClient.exe, which streams; the process
        that gathers candidates is this one, and with no rule for it every
        connectivity check times out and the peers fall back to a relay. The
        daemon also asserts this rule at every start, so a deleted one comes
        back — the two are deliberately the same rule by name, and the daemon
        replaces one pointing at another binary rather than adding a second.

        Sourced from outside DeployDir on purpose: `OmnuvDependencies`
        below harvests that whole tree, and a file it generates a component for
        is a file nothing can attach a service or a firewall rule to.
      -->
      <Component Id="OnvTunnel">
        <File Id="OnvTunneldExe"
              KeyPath="yes"
              Checksum="yes"
              Source="$(var.TunnelDir)\onvtunneld.exe">
          <fire:FirewallException Id="OnvTunnelFirewallException"
                                  Scope="any"
                                  IgnoreFailure="yes"
                                  Name="Omnuv private network" />
        </File>
        <ServiceInstall Id="OnvTunnelService"
                        Name="OnvTunnel"
                        DisplayName="Omnuv private network"
                        Description="Holds this device's WireGuard adapter for its Omnuv private network."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes" />
        <!--
          **Not waited on.** A joined tunnel tears its adapter and routes down
          before it exits, and on the rig sixty seconds stopped being enough
          once the machine was a real peer. An installer that appears hung is
          worse than a file Windows removes at the next boot, so the stop is
          asked for and not blocked on.
        -->
        <ServiceControl Id="OnvTunnelServiceControl"
                        Name="OnvTunnel"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="no" />
      </Component>

      <!--
        Lazy-loaded by the tunnel at the moment it creates an adapter, so it is
        not linked, `windeployqt` never sees it, and its absence is invisible
        until the first join fails. Redistribution is permitted for exactly
        this case by the Wintun licence's clause 3(d); LICENSE.txt travels with
        it because 3(c) requires the notices to stay with the binary.
      -->
      <Component Id="OnvWintun">
        <File Id="WintunDll" KeyPath="yes" Source="$(var.TunnelDir)\wintun.dll" />
        <File Id="WintunLicense" Source="$(var.TunnelDir)\WINTUN-LICENSE.txt" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="OmnuvDependencies" Directory="INSTALLFOLDER">
      <!--
        This harvests whatever is in the deploy directory, and the tunnel must
        not be in it *at this point in the build*. `build-arch.bat` copies the
        tunnel here only after WiX has run, for the portable package, because a
        harvested file gets a generated component and two components installing
        one file is WIX0369.

        WiX 7's Files element has no Exclude attribute, so the ordering is the
        whole mechanism — and what breaks it is a stale copy from an earlier
        build that `rmdir` could not remove because the OnvTunnel service was
        running out of this directory. The rig's build script stops that
        service before it starts.
      -->
      <Files Include="$(var.DeployDir)\**" />
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="Omnuv Client" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="OmnuvClient" />
      <ComponentRef Id="OmnuvShortcuts" />
      <ComponentRef Id="OmnuvDesktopShortcutState" />
      <ComponentRef Id="OmnuvDesktopShortcut" />
      <ComponentRef Id="OnvTunnel" />
      <ComponentRef Id="OnvWintun" />
      <ComponentRef Id="OmnuvLinks" />
      <ComponentGroupRef Id="OmnuvDependencies" />
    </Feature>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.InstallFolder)" />
    </StandardDirectory>
  </Package>
</Wix>
